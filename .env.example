# SIH 26121 eRTMAC-NWIS — demo environment (never commit real secrets)
# Copy to .env (repo root) and frontend/.env.local as needed.

# --- Backend ---
APP_NAME=eRTMAC-NWIS
APP_ENV=demo
SECRET_KEY=change-me-to-a-long-random-string-for-demo-only
ACCESS_TOKEN_EXPIRE_MINUTES=480
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgresql+psycopg://nwis:nwis_demo_password@localhost:5432/nwis
REDIS_URL=redis://localhost:6379/0

UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15

# Demo geospatial block (synthetic coordinates — not operational survey data)
DEMO_REGION_NAME=NWIS Synthetic Block A
DEMO_REGION_LAT=27.4720
DEMO_REGION_LON=95.3180
DEFAULT_RADIUS_KM=8

# Optional services — app remains functional if unset/unavailable
ENABLE_OCR=false
ENABLE_EMBEDDINGS=false
ENABLE_ML_MODEL=true
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Demo auth disclaimer flag
DEMO_AUTH=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
NEXT_PUBLIC_DEMO_AUTH=true
NEXT_PUBLIC_MAP_CENTER_LAT=27.4720
NEXT_PUBLIC_MAP_CENTER_LON=95.3180
